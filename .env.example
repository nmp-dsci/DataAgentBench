# Copy to .env. Never commit .env.
#
# This build calls no model and needs no key. The variables below are the
# only ones the code reads.

# Pinned upstream commit for `make upstream`; leave unset to take the tip of main
# and record whatever commit that is in data/index/source.json.
# DAB_UPSTREAM_COMMIT=

# Set by CI / an image build so /healthz can name the code it runs.
# DAB_CODE_SHA=

# ---- the agent build (plan s01) ---------------------------------------------
# This project's Postgres (infra/docker-compose.yml, `make db-up`), until the data
# migrates to nmp-central-ai (M8). Owner URL for `dab data load` / `dab context build`;
# agent URL is the read-only role the agent's query_db connects as.
# DATABASE_URL=postgresql://dab_owner:dab_owner@localhost:5433/nmp
# AGENT_DATABASE_URL=postgresql://dab_agent:dab_agent@localhost:5433/nmp
# PG_SUPERUSER_URL=postgresql://nmp:nmp@localhost:5433/nmp

# The central MLflow (nmp-central-ai, `make platform-up`). Never a local store.
# MLFLOW_TRACKING_URI=http://localhost:5000

# Eval runs bill the Claude subscription through the Agent SDK's CLI child.
# `subscription` (default) refuses to start if ANTHROPIC_API_KEY is set; `api` requires it.
# BILLING=subscription
