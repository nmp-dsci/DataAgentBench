# Copy to .env. Never commit .env.
#
# This build calls no model and needs no key. The variables below are the
# only ones the code reads.

# Pinned upstream commit for `make upstream`; leave unset to take the tip of main
# and record whatever commit that is in data/index/source.json.
# DAB_UPSTREAM_COMMIT=

# Set by CI / an image build so /healthz can name the code it runs.
# DAB_CODE_SHA=
