# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Secrets — never commit
.env
.env.*
!.env.example

# The upstream benchmark clone (`make upstream`): shallow, LFS skipped. The
# committed index under data/index/ and the answer copies under data/answers/
# are what the app, CI and tests read.
data/upstream/

# Database files live under data/upstream/ (downloaded by `dab data download`,
# 8.4 GB) and in the Postgres volume; never committed. data/context/ is the
# committed context pack: text only (schema, profile, samples, joins, curated
# summary and pitfalls).

# Eval runs: one folder per run. The four record files are committed — they are
# what the case study, the Runs tab and every quoted number read — and the rest
# of a run folder (traces, the agent and context copies, optimiser sessions, the
# history, the submission) stays local, as does the sandbox workspace.
runs/*/*
!runs/*/run.json
!runs/*/results.jsonl
!runs/*/scorecard.json
!runs/*/ledger.json
workspace/

# Per-row rescore verdicts are large; the per-query summary in
# data/index/trials.json is the committed record.
data/index/verdicts.jsonl

# Node / frontend
node_modules/
frontend/dist/

# OS / editor
.DS_Store
